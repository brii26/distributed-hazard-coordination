# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# secrets
.env

# Emacs
*~
\#*#
.#*

# Go
/bin/
*.test

# `go build` with no -o run inside a service dir produces a binary
# named after that directory (e.g. services/bmkg-mock/bmkg-mock).
services/*/bmkg-mock
services/*/pvmbg-mock
services/*/aggregator
services/*/client-facing-api
services/*/auth-service
services/*/dashboard-updater
services/*/notifier
services/*/audit-logger


# local learning scratchpad, never committed
/playground/

# web-frontend (SvelteKit)
services/web-frontend/node_modules/
services/web-frontend/.svelte-kit/
services/web-frontend/build/
tests/load/results/

# graphify: generated graph, caches and ignore rules
/graphify-out/
.graphify*

# LaTeX report build output
/doc/latex/build/
/doc/latex/figures/*.pdf

# signature images stay local, only the folder is tracked
doc/latex/figures/ttd/*
!doc/latex/figures/ttd/.gitkeep
