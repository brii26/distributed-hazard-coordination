#cloud-config
hostname: @NAME@
manage_etc_hosts: false
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - @SSH_PUBKEY@
ssh_pwauth: false
package_update: false
runcmd:
  - [ sh, -c, "printf '127.0.1.1 @NAME@\n@HOSTS@' >> /etc/hosts" ]
  - [ systemctl, disable, --now, ufw ]
  - [ sh, -c, "cp --remove-destination /usr/sbin/xtables-nft-multi /usr/sbin/iptables" ]
