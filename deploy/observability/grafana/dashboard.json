{
  "uid": "hazard-overview",
  "title": "Hazard Coordination Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (req/s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{service_name}}",
        "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[1m]))"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "Error rate (share of requests)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{service_name}}",
        "expr": "(sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\", status_code=\"STATUS_CODE_ERROR\"}[1m])) / sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[1m]))) or (0 * sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[1m])))"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Latency p50 (ms)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{service_name}}",
        "expr": "histogram_quantile(0.5, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[5m])))"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Latency p95 (ms)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{service_name}}",
        "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[5m])))"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Service alive (spans in the last minute)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [{"refId": "A", "legendFormat": "{{service_name}}",
        "expr": "sum by (service_name) (increase(traces_span_metrics_calls_total[1m]))"}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Pod restarts",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [{"refId": "A", "legendFormat": "{{pod}}",
        "expr": "sum by (pod) (kube_pod_container_status_restarts_total)"}]
    },
    {
      "id": 7, "type": "state-timeline", "title": "Pod ready",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "mappings": [{"type": "value", "options": {"0": {"text": "not ready", "color": "red"}, "1": {"text": "ready", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "targets": [{"refId": "A", "legendFormat": "{{pod}}",
        "expr": "kube_pod_status_ready{condition=\"true\"}"}]
    },
    {
      "id": 12, "type": "stat", "title": "Deployments short of desired replicas (red = scaled down or failing)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 24},
      "options": {"colorMode": "background", "textMode": "value_and_name", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0, "unit": "short",
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{deployment}}",
        "expr": "kube_deployment_spec_replicas - kube_deployment_status_replicas_available"}]
    },
    {"id": 8, "type": "row", "title": "Lag", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30}, "panels": []},
    {"id": 9, "type": "row", "title": "Breaker", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}, "panels": []},
    {"id": 10, "type": "row", "title": "Shards", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "panels": []},
    {"id": 11, "type": "row", "title": "Replicas", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33}, "panels": []},
    {"id": 20, "type": "row", "title": "SLO and error budget (doc/P5_SLO.md)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}, "panels": []},
    {
      "id": 21, "type": "stat", "title": "Critical alert SLI: delivered within 5 s (target 99.9%, last 5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 35},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 3,
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.999}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "slo:critical_alert_sli:ratio_rate5m"}]
    },
    {
      "id": 22, "type": "stat", "title": "Read availability SLI: Tim Lapangan (target 99.5%, last 5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 35},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 3,
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "slo:read_sli:ratio_rate5m"}]
    },
    {
      "id": 23, "type": "stat", "title": "Critical alert error budget remaining over the selected time range (below 0 = exhausted)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 35},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1,
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0}, {"color": "green", "value": 0.25}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "(1 - (1 - sum(increase(critical_alert_latency_seconds_bucket{le=\"5\"}[$__range])) / sum(increase(critical_alert_latency_seconds_count[$__range]))) / 0.001) or on() vector(1)"}]
    },
    {
      "id": 24, "type": "stat", "title": "Read availability error budget remaining over the selected time range (below 0 = exhausted)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 35},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1,
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0}, {"color": "green", "value": 0.25}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "(1 - (((sum(increase(traces_span_metrics_calls_total{service_name=\"client-facing-api\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__range])) or on() vector(0)) + (sum(increase(client_api_inflight_rejected_requests_total{role=\"Lapangan\"}[$__range])) or on() vector(0))) / clamp_min(sum(increase(traces_span_metrics_calls_total{service_name=\"client-facing-api\", span_kind=\"SPAN_KIND_SERVER\"}[$__range])) - (sum(increase(client_api_inflight_rejected_requests_total{role!=\"Lapangan\"}[$__range])) or on() vector(0)), 0)) / 0.005) or on() vector(1)"}]
    },
    {
      "id": 25, "type": "timeseries", "title": "Burn rate (1 = spending the budget exactly over the SLO window; lines at 6 and 14.4 are the alert thresholds)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "fieldConfig": {"defaults": {"unit": "none", "min": 0, "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 6}, {"color": "red", "value": 14.4}]}}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "critical alert 5m", "expr": "slo:critical_alert_burn_rate:rate5m"},
        {"refId": "B", "legendFormat": "critical alert 1h", "expr": "slo:critical_alert_burn_rate:rate1h"},
        {"refId": "C", "legendFormat": "read 5m", "expr": "slo:read_burn_rate:rate5m"},
        {"refId": "D", "legendFormat": "read 1h", "expr": "slo:read_burn_rate:rate1h"}
      ]
    },
    {
      "id": 26, "type": "timeseries", "title": "Error budget remaining (trailing 2h, below 0 = exhausted)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "critical alert", "expr": "slo:critical_alert_error_budget_remaining:ratio2h"},
        {"refId": "B", "legendFormat": "read availability", "expr": "slo:read_error_budget_remaining:ratio2h"}
      ]
    },
    {
      "id": 27, "type": "stat", "title": "Critical alerts in the selected time range: delivered, late (over 5 s), staged but undelivered (last 10m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 48},
      "options": {"colorMode": "value", "textMode": "value_and_name", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "delivered", "expr": "sum(increase(critical_alerts_delivered_total[$__range])) or on() vector(0)"},
        {"refId": "B", "legendFormat": "late", "expr": "(sum(increase(critical_alert_latency_seconds_count[$__range])) - sum(increase(critical_alert_latency_seconds_bucket{le=\"5\"}[$__range]))) or on() vector(0)"},
        {"refId": "C", "legendFormat": "undelivered", "expr": "slo:critical_alert_undelivered:count10m"}
      ]
    },
    {
      "id": 28, "type": "timeseries", "title": "Aggregator replicas (HPA current, desired, min and max)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 53},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"refId": "A", "legendFormat": "ready pods", "expr": "kube_deployment_status_replicas_available{deployment=\"aggregator\"}"},
        {"refId": "B", "legendFormat": "current", "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"aggregator\"}"},
        {"refId": "C", "legendFormat": "desired", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"aggregator\"}"},
        {"refId": "D", "legendFormat": "min", "expr": "kube_horizontalpodautoscaler_spec_min_replicas{horizontalpodautoscaler=\"aggregator\"}"},
        {"refId": "E", "legendFormat": "max", "expr": "kube_horizontalpodautoscaler_spec_max_replicas{horizontalpodautoscaler=\"aggregator\"}"}
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Data delay between nodes (bonus, physical hosts): shards short of a copy, shards on the wrong node, repair rows per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "description": "Real signals from the aggregator repair loop (doc/P1_STORAGE_DESIGN.md), exported by the lease holder only. A shard short of a copy is data that has not reached its second node yet, so it grows while a node is cut off and returns to 0 after the repair loop copies the rows. There is no per-row replication lag in seconds in the code, so none is shown.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "shards short of a copy",
          "expr": "max(store_shards_underreplicated)"
        },
        {
          "refId": "B",
          "legendFormat": "shards on the wrong node",
          "expr": "max(store_shards_misplaced)"
        },
        {
          "refId": "C",
          "legendFormat": "repair rows per second",
          "expr": "sum(rate(store_repair_rows_total[1m]))"
        }
      ]
    },
    {
      "id": 31,
      "type": "text",
      "title": "Inter-node latency (bonus, physical hosts): measured by tests/bonus/net-latency.sh",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 69
      },
      "options": {
        "mode": "markdown",
        "content": "Inter-node round trip time and throughput are not a Prometheus metric here. No exporter runs on the nodes and the cluster has no Pushgateway or node exporter, so a graph would need a metric nobody produces. `tests/bonus/net-latency.sh` measures every node pair with `ping` and `iperf3` over ssh and writes `tests/bonus/results/net-latency-<time>.txt` (evidence) and a `.prom` file with the same numbers. Read the numbers there and in `doc/BONUS_PHYSICAL_HOSTS.md`, then compare them with the data delay graph above during the network cut."
      }
    },
    {"id": 40, "type": "row", "title": "Satellite fires (P4, #315)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 75}, "panels": []},
    {
      "id": 41, "type": "timeseries", "title": "Satellite offset lag (feed events emitted but not yet saved; criterion 4: back near 0 within 60 s after a burst)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 76},
      "description": "latest_offset from the feed's /v1/session (polled every 5 s) minus the last offset saved, published and bookmarked. Only the aggregator holding the SATELIT lease exports it.",
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"refId": "A", "legendFormat": "offset lag", "expr": "max(aggregator_satelit_offset_lag)"}]
    },
    {
      "id": 42, "type": "timeseries", "title": "Satellite read to saved latency, p50 and p95 (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 76},
      "description": "Time from the reader receiving a record to its batch being saved, published with broker confirms and bookmarked.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"refId": "A", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(aggregator_satelit_read_to_saved_seconds_bucket[1m])))"},
        {"refId": "B", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(aggregator_satelit_read_to_saved_seconds_bucket[1m])))"}
      ]
    },
    {
      "id": 43, "type": "timeseries", "title": "Satellite throughput: records saved per second, and records read but not yet applied (pile, bounded at 2048)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 84},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"refId": "A", "legendFormat": "saved per second", "expr": "sum(rate(aggregator_satelit_read_to_saved_seconds_count[1m]))"},
        {"refId": "B", "legendFormat": "pile", "expr": "max(aggregator_satelit_pile)"}
      ]
    },
    {
      "id": 44, "type": "timeseries", "title": "Satellite feed-time lag (feed time behind virtual_now; at speed 60 one wall second is one feed minute)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 84},
      "description": "virtual_now from /v1/session minus the feed clock at the last saved offset. The feed clock moves with heartbeats, so the floor is the heartbeat spacing in feed time even when nothing is behind.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"refId": "A", "legendFormat": "feed-time lag", "expr": "max(aggregator_satelit_feed_time_lag_seconds)"}]
    },
    {
      "id": 45, "type": "stat", "title": "Satellite fire engine counts (too late, unknown target, re-sent, tombstone rejected, singles), records parked in the selected time range, last rebuild time (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 92},
      "description": "The engine counts are running totals over the whole feed. A restart rebuilds them by replay, so they match a run without a crash.",
      "options": {"colorMode": "value", "textMode": "value_and_name", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{kind}}", "expr": "max by (kind) (aggregator_satelit_engine_count)"},
        {"refId": "B", "legendFormat": "parked", "expr": "sum(increase(aggregator_satelit_parked_total[$__range])) or on() vector(0)"},
        {"refId": "C", "legendFormat": "rebuild (s)", "expr": "max(aggregator_satelit_rebuild_seconds)"}
      ]
    }
  ]
}
