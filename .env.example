# Copy to .env and fill in real values. Never commit .env.
# See the Configuration reference section of README.md for what each variable controls.

# --- BMKG mock ---
BMKG_PORT=8081
BMKG_API_KEY=change-me-bmkg-key
BMKG_SEED_COUNT=20
BMKG_EVENT_INTERVAL_S=10
BMKG_DELAY_MIN_MS=50
BMKG_DELAY_MAX_MS=150

# --- PVMBG mock ---
PVMBG_PORT=8082
PVMBG_OAUTH_CLIENT_ID=change-me-client-id
PVMBG_OAUTH_CLIENT_SECRET=change-me-client-secret
PVMBG_ONE_TIME_CODE=change-me-one-time-code
PVMBG_ADMIN_KEY=change-me-admin-key
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_SEED_COUNT=20
PVMBG_EVENT_INTERVAL_S=10

# --- Canonical Store (Postgres) ---
CANONICAL_DB_USER=aggregator
CANONICAL_DB_PASSWORD=change-me
CANONICAL_DB_NAME=canonical_store

# --- User DB (Postgres, owned by auth-service) ---
USER_DB_USER=auth
USER_DB_PASSWORD=change-me
USER_DB_NAME=user_db

# --- RabbitMQ ---
RABBITMQ_USER=hazard
RABBITMQ_PASSWORD=change-me
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=hazard.events

# --- Aggregator ---
POLL_INTERVAL_MS=3000
POLL_TIMEOUT_MS=4000
CB_FAILURE_THRESHOLD=3
CB_OPEN_DURATION_MS=10000
AGGREGATOR_MAX_INFLIGHT_REQUESTS=100
DB_POOL_SIZE=20

# --- Auth/Token Service ---
JWT_SIGNING_SECRET=change-me-long-random-secret
SECRET_SALT=change-me-salt
# Access token lifetime in seconds, the same for every role.
ACCESS_TOKEN_TTL_S=60
SEED_OPERATOR_EMAIL=operator@bnpb.example
SEED_OPERATOR_PASSWORD=change-me

# --- Client-Facing API ---
CLIENT_FACING_API_PORT=8080
CLIENT_FACING_API_MAX_INFLIGHT_REQUESTS=100
RATE_LIMIT_RPS=50
AUTH_RATE_LIMIT_RPS=10
UPSTREAM_TIMEOUT_MS=1000
# Mark the jwt/refresh_token cookies Secure (HTTPS only). Browsers still accept them on
# http://localhost; set false only for a plain-HTTP demo on another host.
COOKIE_SECURE=true

# --- Web Frontend ---
WEB_FRONTEND_PORT=3000
# Baked into the image at build time. /api = the frontend's own nginx, which proxies to the
# Client-Facing API so the HttpOnly cookies stay same-origin. A full URL calls an API on
# another origin, which would also need CORS with credentials on the Client-Facing API.
CLIENT_FACING_API_BASE_URL=/api
FRONTEND_POLL_INTERVAL_MS=5000

# --- Tracing (Jaeger) ---
# Every Go service exports OpenTelemetry spans over OTLP gRPC. Set TRACING_ENABLED=false to turn it off.
# Jaeger being down never affects the services. UI: http://localhost:${JAEGER_UI_PORT}
# The Monitor tab (request rate, errors, latency) is fed by the prometheus container, which only the compose network sees.
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
JAEGER_UI_PORT=16686
